flowchart TD
    %% FRONTEND
    subgraph UI ["🖥️ Frontend Layer (React SPA)"]
        CustomerPortal["👤 Customer Portal<br/>(Chat & KYC Upload)"]
        AdminDashboard["📊 Operations Dashboard<br/>(SLA Queue & Batch Follow-up)"]
    end

    %% BACKEND GATEWAY
    subgraph API ["⚡ Backend Gateway (FastAPI)"]
        Gateway["FastAPI Gateway<br/>(Rate Limiting & Correlation Logs)"]
    end

    %% AGENT ENGINE
    subgraph Engine ["🧠 LangGraph Agent Workflow"]
        Greeting["1. Greeting & Tier Selection"]
        CollectInfo["2. Info Extraction (Name/Email/Phone)"]
        DocumentKYC["3. Document Verification Loop"]
        Provisioning["4. Account Activation (SLA Met)"]

        Greeting --> CollectInfo
        CollectInfo --> DocumentKYC
        DocumentKYC --> Provisioning
    end

    %% HUMAN IN THE LOOP
    subgraph HITL ["👨‍💼 Human-in-the-Loop Review"]
        Escalation["Escalation Queue<br/>(Triggered after 3 AI Failures)"]
        HumanAction["Approve / Re-upload / Reject"]
        Escalation --> HumanAction
    end

    %% EXTERNAL AI
    subgraph AI ["☁️ External AI Cloud"]
        Groq["Groq Multimodal Vision & LLM<br/>• OCR & Document Match<br/>• Proactive SLA Reminders"]
    end

    %% DATABASE
    subgraph DB ["💾 Persistence & Storage"]
        Database[("PostgreSQL Neon DB<br/>• Customers & KYC State<br/>• LangGraph Checkpointer<br/>• SLA & Escalation Tickets")]
    end

    %% FLOW CONNECTIONS
    CustomerPortal <--> Gateway
    AdminDashboard <--> Gateway

    Gateway <--> Engine
    DocumentKYC <-->|"Multimodal OCR"| Groq
    DocumentKYC -- "Failed 3 Times" --> Escalation
    HumanAction -- "Approved" --> DocumentKYC
    HumanAction -- "Rejected" --> Database

    Engine <-->|"Save State & Session"| Database
    Gateway <--> Database

    %% CLEAN / SOFT SUBGRAPH BACKGROUNDS
